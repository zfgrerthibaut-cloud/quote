# Required by API, indexer and migrations. Keep the password URL-encoded.
DATABASE_URL=

# API
PORT=8787
QUOTE_WEB_ORIGINS=https://quote.example.com
QUOTE_HTTP_MAX_BODY_BYTES=32768
QUOTE_WS_MAX_CLIENTS=2000
QUOTE_WS_MAX_REPLAY_LAG=50000
QUOTE_WS_MAX_BUFFERED_BYTES=1000000
QUOTE_WS_ALLOW_MISSING_ORIGIN=false
QUOTE_SSE_ENABLED=true
QUOTE_SSE_MAX_CLIENTS=500
QUOTE_SSE_REPLAY_LIMIT=500
QUOTE_SSE_POLL_MS=750
QUOTE_SSE_HEARTBEAT_MS=15000

# PostgreSQL client limits used by API, indexer, media worker and migrations.
QUOTE_PG_POOL_MAX=8
QUOTE_PG_CONNECT_TIMEOUT_MS=5000
QUOTE_PG_IDLE_TIMEOUT_MS=30000
QUOTE_PG_QUERY_TIMEOUT_MS=15000
QUOTE_PG_STATEMENT_TIMEOUT_MS=15000
QUOTE_PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Optional server-only media providers. Leave blank unless credentials and redistribution rights are configured.
GMGN_API_KEY=
GMGN_CLIENT_ID=
CODEX_API_KEY=

# Indexer
BSC_HTTP_RPC_URL=
BSC_WSS_RPC_URL=
QUOTE_INDEXER_REGISTRY_JSON=
QUOTE_INDEXER_CONFIRMATION_DEPTH=15
QUOTE_INDEXER_CHUNK_SIZE=250
QUOTE_INDEXER_MAX_REORG_DEPTH=256
QUOTE_INDEXER_POLL_MS=15000

# Quote-token eligibility API. Factory must be the canonical Pancake V3 factory for BSC.
QUOTE_ELIGIBILITY_FACTORY_ADDRESS=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865
QUOTE_ELIGIBILITY_STABLE_USD_TOKENS=
QUOTE_ELIGIBILITY_CHAINLINK_FEEDS_JSON={}
QUOTE_ELIGIBILITY_ALLOWED_POOL_FEES=10000
QUOTE_ELIGIBILITY_MIN_QUOTE_DEPTH_USD=10000
QUOTE_ELIGIBILITY_TWAP_WINDOW_SECONDS=900
QUOTE_ELIGIBILITY_MAX_BODY_BYTES=1024
QUOTE_ELIGIBILITY_RATE_LIMIT_PER_MINUTE=30
QUOTE_ELIGIBILITY_RPC_TIMEOUT_MS=5000
QUOTE_ELIGIBILITY_RPC_MAX_ATTEMPTS=2
