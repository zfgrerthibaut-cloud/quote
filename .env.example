# Coolify / Docker Compose. Replace every placeholder in Coolify; do not commit real values.
POSTGRES_DB=quote
POSTGRES_USER=quote
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://quote:replace-with-a-long-random-password@postgres:5432/quote

QUOTE_WEB_ORIGINS=https://quote.example
NEXT_PUBLIC_QUOTE_API_URL=https://api.quote.example
